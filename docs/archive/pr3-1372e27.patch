+/** 去掉 @keyframes 块（大括号配平地扫）：百分比停点长得像选择器，留着会被当成裸选择器。 */
+function stripKeyframes(css) {
+  let out = '';
+  let i = 0;
+  while (i < css.length) {
+    const at = css.indexOf('@keyframes', i);
+    if (at < 0) { out += css.slice(i); break; }
+    out += css.slice(i, at);
+    let j = css.indexOf('{', at);
+    if (j < 0) { out += css.slice(at); break; }
+    let depth = 0;
+    while (j < css.length) {
+      if (css[j] === '{') depth += 1;
+      else if (css[j] === '}') { depth -= 1; if (depth === 0) { j += 1; break; } }
+      j += 1;
+    }
+    i = j;
+  }
+  return out;
+}
